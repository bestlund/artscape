# rs-sdk ships custom content, so the original-game checksums never match.
# Upstream builds with this too (server/Dockerfile, CI).
BUILD_VERIFY=false

# ArtScape: local accounts with staff rights (::tele, ::speed, ::give, ::~maxme).
LOCAL_STAFF_USERS=jacob

# ArtScape: no automatic content reloads; use ::rebuild in-game (staff) after editing content.
BUILD_LIVE_RELOAD=false
